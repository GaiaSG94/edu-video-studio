# Clé API Anthropic — connecte le site à ton compte Claude.
# Sans cette variable, le site utilise un générateur de storyboard local (mode démo).
ANTHROPIC_API_KEY=
# Modèle Claude utilisé (optionnel, par défaut claude-sonnet-4-5).
ANTHROPIC_MODEL=claude-sonnet-4-5

# Voix off (optionnel).
# 1) ElevenLabs : meilleure qualité, clé API + voix (Rachel par défaut).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# 2) Sans clé ElevenLabs, le site essaie Kokoro en local via `hyperframes tts`.
# 3) Si aucune voix n'est disponible, la vidéo est générée sans piste audio.
